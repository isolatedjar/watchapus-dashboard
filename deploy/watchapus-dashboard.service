[Unit]
Description=Watchapus host memory dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/watchapus-dashboard
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/watchapus-dashboard/src/server.ts
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=watchapus-dashboard
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
